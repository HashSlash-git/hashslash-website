# Front-end settings on Hostinger. This file is copied into the site folder (public_html/site) by each deploy.
# The domain routing itself lives in public_html/.htaccess (written by the HashSlash Headless plugin).

# Our own rewrite context: stops WordPress's rules in the parent folder from catching front-end URLs.
RewriteEngine On
DirectoryIndex index.html
ErrorDocument 404 /site/404.html
Options -Indexes

<IfModule mod_headers.c>
  # fingerprinted scripts/styles and fonts never change
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # pages always revalidate so publishes show up straight away
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
