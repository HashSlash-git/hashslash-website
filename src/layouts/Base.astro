---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/pages.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props { title: string; description: string; bodyClass?: string; }
const { title, description, bodyClass = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#080909" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <!-- fonts are self-hosted (src/styles/fonts.css); preload the one every page paints first -->
  <link rel="preload" href="/fonts/archivo-400-latin.woff2" as="font" type="font/woff2" crossorigin />
  <script is:inline>
    (function () {
      var d = document.documentElement;
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('motion');
      try { if (sessionStorage.getItem('hs-pt')) { d.classList.add('pt-in'); d.classList.add('pt-arrive'); } } catch (e) {}
      setTimeout(function () { if (!window.__hsReady) { d.classList.remove('motion'); d.classList.remove('pt-in'); } }, 4000);
    })();
  </script>
  <slot name="head" />
</head>
<body class={bodyClass}>
  <a class="skip" href="#main">Skip to content</a>
  <Nav />
  <main id="main"><slot /></main>
  <Footer />

  <a class="wa-float" href="#" data-whatsapp data-track="whatsapp_click" data-loc="float" aria-label="Chat on WhatsApp">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.6-.3z"/></svg>
  </a>
  <div class="mbar">
    <a class="btn btn--lime" href="tel:+917259190306" data-book data-track="booking_start" data-loc="mobile_bar">Book a free call</a>
    <a class="btn btn--ghost" href="#" data-whatsapp data-track="whatsapp_click" data-loc="mobile_bar">WhatsApp</a>
  </div>

  <!-- "Book a call" on desktop: call-back request (phones dial instead, see core.js callLinks) -->
  <dialog class="cb" id="callback" aria-labelledby="cb-h">
    <form class="cb__form" name="callback" method="POST" data-netlify="true" netlify-honeypot="company_website" novalidate>
      <input type="hidden" name="form-name" value="callback" />
      <input type="hidden" name="page" value="" />
      <input type="hidden" name="source" value="" />
      <p hidden><label>Leave this empty <input name="company_website" tabindex="-1" autocomplete="off" /></label></p>
      <button type="button" class="cb__x" data-cb-close aria-label="Close">&times;</button>
      <p class="mono cb__eyebrow">Free 30-minute strategy call</p>
      <h2 class="display cb__title" id="cb-h">We'll call <span class="lime">you.</span></h2>
      <p class="cb__sub">Leave your number and a good time. A strategist calls you back, usually the same working day.</p>
      <label class="field"><span>Name</span><input name="name" autocomplete="name" required /></label>
      <label class="field"><span>Phone</span><input name="phone" type="tel" autocomplete="tel" placeholder="+91" required /></label>
      <label class="field"><span>Best time to call</span>
        <select name="best_time">
          <option>Morning (10 am – 1 pm)</option>
          <option>Afternoon (1 – 5 pm)</option>
          <option>Evening (5 – 8 pm)</option>
          <option>Any time</option>
        </select>
      </label>
      <p class="ferr" aria-live="polite"></p>
      <button type="submit" class="btn btn--lime btn--lg cb__send">Request my call &rarr;</button>
      <p class="cb__alt">Prefer to call now? <a href="tel:+917259190306" data-track="call_click" data-loc="callback_dialog">+91 72591 90306</a> · <a href="#" data-whatsapp data-track="whatsapp_click" data-loc="callback_dialog">WhatsApp</a></p>
    </form>
  </dialog>

  <!-- #/. page transition -->
  <div class="pt" aria-hidden="true"><span class="pt__circle"></span><span class="pt__mark">#/.</span></div>
</body>
</html>
