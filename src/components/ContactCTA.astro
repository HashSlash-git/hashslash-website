---
import { formServices } from '../data/services.js';
interface Props { line1?: string; line2?: string; sub?: string; preselect?: string; idx?: string; loc?: string; }
const {
  line1 = 'Deploy',
  line2 = 'the arsenal.',
  sub = "Tell us where you want to be in 12 months. We'll show you the build, the campaigns and the plan to get there.",
  preselect = '',
  idx = "Let's go",
  loc = 'contact'
} = Astro.props;
const [l2a, ...l2rest] = line2.split(' ');
---
<section class="contact" id="contact" aria-labelledby="contact-h">
  <canvas class="terrain" aria-hidden="true"></canvas>
  <div class="contact__inner">
    <div class="contact__pitch">
      <p class="mono sec-head__idx">{idx}</p>
      <h2 class="display contact__title" id="contact-h"><span class="line"><span class="line__in">{line1}</span></span><span class="line"><span class="line__in">{l2a} <span class="lime">{l2rest.join(' ')}</span></span></span></h2>
      <p class="contact__sub">{sub}</p>
      <div class="routes">
        <a class="route" href="#" data-book-url data-track="booking_start" data-loc={loc}>
          <span class="route__k mono">01</span><span class="route__t">Book a free strategy call</span><span class="route__d">30 min with a strategist · +91 72591 90306</span>
        </a>
        <a class="route" href="#" data-whatsapp data-track="whatsapp_click" data-loc={loc}>
          <span class="route__k mono">02</span><span class="route__t">Chat on WhatsApp</span><span class="route__d">Quick questions, fast replies</span>
        </a>
      </div>
    </div>

    <form class="enquiry" id="enquiry" name="enquiry" method="POST" data-netlify="true" netlify-honeypot="company_website" novalidate data-loc={loc}>
      <!-- Netlify Forms: form-name routes the submission; company_website is a spam honeypot; page/event_id are filled by core.js -->
      <input type="hidden" name="form-name" value="enquiry" />
      <input type="hidden" name="page" value="" />
      <input type="hidden" name="event_id" value="" />
      <p hidden><label>Leave this empty <input name="company_website" tabindex="-1" autocomplete="off" /></label></p>
      <div class="enquiry__top">
        <p class="mono">Project enquiry</p>
        <p class="mono enquiry__step-label"><span data-step-now>1</span> / 3</p>
      </div>
      <div class="enquiry__bar"><span></span></div>

      <fieldset class="fstep is-active" data-step="1">
        <legend>What do you need?</legend>
        <div class="pills" role="group" aria-label="Services required">
          {formServices.map((v) => (
            <label><input type="checkbox" name="services" value={v} checked={v === preselect} /><span>{v}</span></label>
          ))}
        </div>
        <label class="field">
          <span>Industry</span>
          <select name="industry" required>
            <option value="">Select your industry</option>
            <option>E-commerce &amp; D2C</option>
            <option>IT &amp; Healthcare</option>
            <option>Hospitality</option>
            <option>Real Estate</option>
            <option>Other</option>
          </select>
        </label>
        <p class="ferr" aria-live="polite"></p>
      </fieldset>

      <fieldset class="fstep" data-step="2">
        <legend>Budget &amp; brief</legend>
        <div class="pills pills--radio" role="radiogroup" aria-label="Approximate budget">
          <!-- TODO: confirm currency + ranges with HashSlash -->
          <label><input type="radio" name="budget" value="Under 2.5k" required /><span>Under 2.5k</span></label>
          <label><input type="radio" name="budget" value="2.5k - 10k" /><span>2.5k – 10k</span></label>
          <label><input type="radio" name="budget" value="10k - 25k" /><span>10k – 25k</span></label>
          <label><input type="radio" name="budget" value="25k+" /><span>25k+</span></label>
          <label><input type="radio" name="budget" value="Not sure" /><span>Not sure yet</span></label>
        </div>
        <label class="field">
          <span>Tell us about the project</span>
          <textarea name="description" rows="4" placeholder="Goals, timelines, links, anything useful" required></textarea>
        </label>
        <p class="ferr" aria-live="polite"></p>
      </fieldset>

      <fieldset class="fstep" data-step="3">
        <legend>Where do we reach you?</legend>
        <div class="grid2">
          <label class="field"><span>Name</span><input name="name" autocomplete="name" required /></label>
          <label class="field"><span>Company</span><input name="company" autocomplete="organization" /></label>
          <label class="field"><span>Email</span><input name="email" type="email" autocomplete="email" required /></label>
          <label class="field"><span>Phone</span><input name="phone" type="tel" autocomplete="tel" required /></label>
        </div>
        <p class="ferr" aria-live="polite"></p>
      </fieldset>

      <div class="enquiry__nav">
        <button type="button" class="btn btn--ghost" data-prev hidden>&larr; Back</button>
        <button type="button" class="btn btn--lime" data-next>Next &rarr;</button>
        <button type="submit" class="btn btn--lime" data-submit hidden>Send enquiry &rarr;</button>
      </div>

    </form>
  </div>
</section>
